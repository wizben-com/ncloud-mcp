# Placeholders only. Not loaded automatically. Export through your trusted MCP host.
NCLOUD_SPEECH_ENABLED=false
NCLOUD_SPEECH_INVOKE_URL=https://clovaspeech-gw.ncloud.com/external/v1/0000/REPLACE_INVOKE_KEY
NCLOUD_SPEECH_SECRET=REPLACE_WITH_SPEECH_DOMAIN_SECRET
# Explicit dedicated recording directories; ':' separated on Linux/macOS.
NCLOUD_SPEECH_LOCAL_ROOTS=
# Comma-separated exact trusted public DNS hostnames; no wildcards.
NCLOUD_SPEECH_URL_HOSTS=
NCLOUD_SPEECH_ALLOW_OBJECT_STORAGE=false
# Opt-in to persistent result storage; configure it in the Speech domain first.
NCLOUD_SPEECH_ALLOW_ASYNC_OBS=false
NCLOUD_SPEECH_MAX_UPLOAD_BYTES=26214400
NCLOUD_SPEECH_TIMEOUT_SECONDS=600
